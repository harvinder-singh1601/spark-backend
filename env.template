# Application
NEXT_PUBLIC_APP_NAME="Spark Delivery"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# API Configuration
NEXT_PUBLIC_API_URL="/api"

# Database Configuration
DATABASE_URL="mongodb://localhost:27017/spark?replicaSet=rs0&retryWrites=true&w=majority"

# MongoDB Configuration (for docker-compose)
MONGODB_HOST="localhost"
MONGODB_PORT="27017"
MONGODB_DATABASE="spark"
MONGODB_REPLICA_SET="rs0"
MONGODB_CONTAINER_NAME="spark-mongodb"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
ACCESS_TOKEN_SECRET="your-super-secret-jwt-key-change-this-in-production"
TOKEN_EXPIRY="7d"

# Google Maps API
# Get your API key from: https://console.cloud.google.com/
# Enable: Maps JavaScript API, Geocoding API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"


